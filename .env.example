# pondok-ai — Environment Variables Template
# Auto-generated by "pondok-ai init". You do not normally need to edit this manually.

# PostgreSQL root credentials
POSTGRES_DB=localaistack
POSTGRES_USER=localaistack
POSTGRES_PASSWORD=replace_with_secure_random_password

# API Gateway configuration
API_PORT=8000
API_SECRET_KEY=replace_with_secure_random_api_key
# Optional comma-separated browser origins allowed to call the API Gateway
CORS_ORIGINS=
# Optional per-source-IP API Gateway rate limit (defaults shown)
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_MS=60000

# n8n workflow credentials (Full preset)
N8N_ENCRYPTION_KEY=replace_with_32_character_encryption_key
