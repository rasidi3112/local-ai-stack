{
  "name": "pondok-ai",
  "version": "0.2.4",
  "description": "Run your own private AI stack locally with one command.",
  "type": "module",
  "bin": {
    "pondok-ai": "dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "local-ai",
    "ollama",
    "llm",
    "rag",
    "docker",
    "cli",
    "open-webui",
    "private-ai",
    "self-hosted",
    "vector-database",
    "qdrant"
  ],
  "author": "rasidi3112 (https://github.com/rasidi3112)",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "api/Dockerfile",
    "api/package.json",
    "api/package-lock.json",
    "api/tsconfig.json",
    "api/src",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rasidi3112/pondok-ai.git"
  },
  "homepage": "https://github.com/rasidi3112/pondok-ai",
  "bugs": {
    "url": "https://github.com/rasidi3112/pondok-ai/issues"
  },
  "dependencies": {
    "boxen": "^8.0.1",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "inquirer": "^9.3.7",
    "js-yaml": "^4.1.0",
    "ora": "^8.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/inquirer": "^9.0.7",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^2.1.5"
  }
}
